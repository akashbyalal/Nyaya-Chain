# Used by Next.js to proxy browser requests from /api/* to the Express backend.
BACKEND_API_URL=http://localhost:4000

# Public Sepolia RPC endpoint used only for read-only on-chain verification.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.example-rpc-provider.com/v1/your-key

# Optional: set only when the backend is deployed separately and intentionally exposed to browsers.
# NEXT_PUBLIC_API_URL=https://api.example.com
